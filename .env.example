# Bulldog Beacon reads ONE key. Put it in a file named .env in this folder,
# or in the folder one level above this repo (the app checks both, this folder first).
PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides (defaults shown). Prices are per million tokens.
# BEACON_PRICE_INPUT=0.10
# BEACON_PRICE_CACHED=0.01
# BEACON_PRICE_OUTPUT=0.50
# BEACON_USER_DAILY_TOKENS=150000
# BEACON_GLOBAL_DAILY_TOKENS=3000000
